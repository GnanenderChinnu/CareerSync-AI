DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=careersync_ai
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Set this to True for local testing when PostgreSQL is not installed.
USE_SQLITE=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# TODO: Add your Firebase Admin SDK JSON path after creating a Firebase project.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# TODO: Add OpenAI or Gemini API key when you replace the mock AI service.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
